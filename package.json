{
  "name": "glean",
  "version": "1.0.0",
  "private": true,
  "description": "Glean — công cụ cá nhân tìm kiếm, đồng bộ và sàng lọc media từ diễn đàn",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,yellow \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@fontsource/lexend": "^5.3.0",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.8",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
