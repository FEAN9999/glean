{
  "name": "glean",
  "version": "1.0.0",
  "private": true,
  "description": "Glean — công cụ cá nhân tìm kiếm, đồng bộ và sàng lọc media từ diễn đàn",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,yellow \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --import tsx --import ./server/test/setup.ts --test \"server/**/*.test.ts\" \"web/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@fontsource/lexend": "^5.3.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "fastify": "^5.12.8",
    "motion": "^14.14.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.1",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.5"
  }
}
